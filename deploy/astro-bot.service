[Unit]
Description=Astro Jyotish Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=astro
WorkingDirectory=/opt/astro
EnvironmentFile=/opt/astro/.env
ExecStart=/opt/astro/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

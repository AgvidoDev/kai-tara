# ============================================================
#  Астрологические прогнозы — настройки бота
#  Файл .env содержит секреты: не коммитить, не пересылать.
# ============================================================

# Токен бота от @BotFather (формат 1234567890:AAH...)
BOT_TOKEN=

# Подключение к PostgreSQL: postgresql://пользователь:пароль@хост:порт/база
DATABASE_URL=postgresql://astro:astro@localhost:5432/astro

# Данные рождения не хранятся — ключ шифрования не нужен.
# FERNET_KEY использовался только для разовой миграции старых записей (migrations/003).

# Ваш Telegram ID (узнать у @userinfobot). Несколько — через запятую.
ADMIN_IDS=

# Монетизация (Telegram Stars). Необязательно — по умолчанию значения ниже.
# PRICE_PREMIUM=199     # ⭐ за 30 дней Премиума (автопродление)
# PRICE_COMPAT=99       # ⭐ за одну проверку совместимости
# TRIAL_DAYS=3          # пробный Премиум после регистрации
# REF_BONUS_DAYS=7      # дней Премиума за приглашённого друга
# DAILY_HOUR=7          # час утренней рассылки «Сегодня» (местное время пользователя)
# FREE_UNTIL=2026-12-31  # промо: до этой даты (включительно, МСК) Премиум бесплатен всем
# PRICE_REPORT=149     # ⭐ за PDF-разбор натальной карты
# FREE_MODE=1          # бесплатный продукт: оплата выключена, все функции открыты
# SOURCE_URL=https://github.com/<user>/kai-tara   # публичный код (AGPL-3.0), команда /source
# WEBAPP_URL=https://your-domain   # Telegram Mini App (нужен HTTPS); пусто — выключен
# WEBAPP_PORT=8111                 # локальный порт веб-сервера Mini App (nginx проксирует на него)
